# 配信のキャッシュ制御。
# version.json はカード更新の検知に使うので短め。
# cards.json は 5MB あるので少し長めに持たせ、あとは ETag による再検証にまかせる。
# events.json は毎起動で読み直す前提。ETag が付くので、変化が無ければ 304 で済む。
/version.json
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *

/cards.json
  Cache-Control: public, max-age=600, must-revalidate
  Access-Control-Allow-Origin: *

# エクストラは 8MB あるうえ、エクストラを使う人が明示的に取りに行くだけの
# ファイル。中身もほとんど動かないので cards.json より長めに持たせる。
/cards-extra.json
  Cache-Control: public, max-age=3600, must-revalidate
  Access-Control-Allow-Origin: *

/events.json
  Cache-Control: public, max-age=0, must-revalidate
  Access-Control-Allow-Origin: *
