{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Workers Builds は `npx wrangler deploy` を実行する。この設定が無いと
  // エントリポイントを見つけられず "error occurred while running deploy command" になる。
  // ダッシュボードで作成した Worker 名に合わせること。
  // ここが食い違うとローカルからの wrangler deploy が別の Worker を作ってしまう。
  //
  // 2026-09 に pokemon-card-scraping から改名した。Worker 名がそのまま
  // workers.dev のホスト名になり、デッキ共有リンクに毎回出るため
  // （「scraping」を配りたくない）。旧ホストは redirect/ の Worker が
  // 新ホストへ 301 で飛ばすので、配信中の旧バージョンのアプリも無事。
  "name": "pokedeck",
  "compatibility_date": "2026-08-24",
  // 配信するのは public/ の静的 JSON だけ。Worker スクリプト（main）は不要。
  // 静的アセットへのリクエストは無料かつ無制限で、帯域課金も無い。
  "assets": {
    "directory": "./public"
  }
}
